rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn()
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isOwner() {
      return role() == 'owner';
    }

    function isManagerOrOwner() {
      return role() in ['owner', 'manager'];
    }

    function isImageUpload() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'image/svg+xml'];
    }

    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if isManagerOrOwner() && isImageUpload();
    }

    match /happy-customers/{customerId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner() && isImageUpload();
    }

    match /site/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner() && isImageUpload();
    }
  }
}

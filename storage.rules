rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function adminProfile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function passwordIsCurrent(profile) {
      return !('mustChangePassword' in profile) || profile.mustChangePassword != true;
    }

    function approvalIsGranted(profile) {
      return !('status' in profile) || profile.status == 'approved';
    }

    function isOwner() {
      return signedIn()
        && adminProfile().role == 'owner'
        && passwordIsCurrent(adminProfile())
        && approvalIsGranted(adminProfile());
    }

    function isManagerOrOwner() {
      return signedIn()
        && adminProfile().role in ['owner', 'manager']
        && passwordIsCurrent(adminProfile())
        && approvalIsGranted(adminProfile());
    }

    function isImageUpload() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'image/svg+xml'];
    }

    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if isManagerOrOwner() && isImageUpload();
    }

    match /happy-customers/{customerId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner() && isImageUpload();
    }

    match /site/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner() && isImageUpload();
    }
  }
}

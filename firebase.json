{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22"
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/robots.txt",
      "**/sitemap.xml"
    ],
    "rewrites": [
      {
        "source": "/robots.txt",
        "function": {
          "functionId": "robotsTxt",
          "region": "us-central1"
        }
      },
      {
        "source": "/sitemap.xml",
        "function": {
          "functionId": "sitemapXml",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function passwordIsCurrent(profile) {
      return !('mustChangePassword' in profile) || profile.mustChangePassword != true;
    }

    function approvalIsGranted(profile) {
      return !('status' in profile) || profile.status == 'approved';
    }

    function isOwner() {
      return signedIn()
        && adminProfile().role == 'owner'
        && passwordIsCurrent(adminProfile())
        && approvalIsGranted(adminProfile());
    }

    function isManagerOrOwner() {
      return signedIn()
        && adminProfile().role in ['owner', 'manager']
        && passwordIsCurrent(adminProfile())
        && approvalIsGranted(adminProfile());
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isManagerOrOwner();
    }

    match /siteSettings/{settingsId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /settings/owner {
      allow read: if true;
      allow write: if false;
    }

    match /settings/site_config {
      allow read: if true;
      allow write: if isOwner();
    }

    match /happyCustomers/{customerId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isOwner());
      allow create, update, delete: if isOwner();
    }
  }
}
